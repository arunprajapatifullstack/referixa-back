datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Business {
  id                 String     @id @default(uuid())
  name               String
  email              String     @unique
  passwordHash       String
  plan               String     @default("free")
  razorpayCustomerId String?
  subscriptionId     String?
  subscriptionStatus String     @default("inactive")
  planUpdatedAt      DateTime?
  avatarUrl          String?
  createdAt          DateTime   @default(now())
  campaigns          Campaign[]
  customers          Customer[]
}

model Campaign {
  id                  String        @id @default(uuid())
  businessId          String
  business            Business      @relation(fields: [businessId], references: [id])
  name                String
  status              String        @default("active")
  referrerRewardType  String
  referrerRewardValue Decimal       @db.Decimal(10, 2)
  referredRewardType  String
  referredRewardValue Decimal       @db.Decimal(10, 2)
  createdAt           DateTime      @default(now())
  referralLinks       ReferralLink[]
}

model Customer {
  id            String         @id @default(uuid())
  businessId    String
  business      Business       @relation(fields: [businessId], references: [id])
  email         String
  name          String?
  createdAt     DateTime       @default(now())
  referralLinks ReferralLink[]

  @@unique([businessId, email])
}

model ReferralLink {
  id         String     @id @default(uuid())
  campaignId String
  campaign   Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer   @relation(fields: [customerId], references: [id])
  code       String     @unique
  clicks     Int        @default(0)
  createdAt  DateTime   @default(now())
  referrals  Referral[]
}

model Referral {
  id             String      @id @default(uuid())
  referralLinkId String
  referralLink   ReferralLink @relation(fields: [referralLinkId], references: [id], onDelete: Cascade)
  referredEmail  String
  status         String      @default("pending")
  convertedAt    DateTime?
  ipAddress      String?
  createdAt      DateTime    @default(now())
  rewards        Reward[]
}

model Reward {
  id            String    @id @default(uuid())
  referralId    String
  referral      Referral  @relation(fields: [referralId], references: [id], onDelete: Cascade)
  recipientType String
  rewardType    String
  rewardValue   Decimal   @db.Decimal(10, 2)
  code          String    @unique
  status        String    @default("issued")
  issuedAt      DateTime  @default(now())
  redeemedAt    DateTime?
}
