# =============================================
# Referixa Backend — Environment Configuration
# =============================================
# Copy this file to .env and fill in your values.

# Database
DATABASE_URL=mysql://root:password@localhost:3306/referloop

# JWT
JWT_SECRET=generate-a-64-byte-hex-string-here
JWT_REFRESH_SECRET=generate-another-64-byte-hex-string-here
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# SendGrid
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
SENDER_EMAIL=you@company.com

# App
FRONTEND_URL=http://localhost:3000
PORT=4000
NODE_ENV=development

# Sentry (optional — leave empty to disable)
SENTRY_DSN=

# S3-compatible storage (optional — leave empty to use local disk)
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
